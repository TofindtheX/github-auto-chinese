{
  "manifest_version": 3,
  "name": "GitHub Auto Chinese",
  "version": "1.0.0",
  "description": "Translate GitHub basic interface text into Simplified Chinese.",

  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "dictionary.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
